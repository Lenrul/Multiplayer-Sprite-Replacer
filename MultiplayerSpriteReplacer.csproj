<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MultiplayerSpriteReplacer</AssemblyName>
    <RootNamespace>Msr</RootNamespace>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0618;CS0649</NoWarn>

    <!-- Paths. Override on the command line: dotnet build -p:GameDir="D:\Games\Casualties Unknown" -->
    <GameDir Condition="'$(GameDir)' == ''">..\..\Casualties Unknown</GameDir>
    <ManagedDir>$(GameDir)\CasualtiesUnknown_Data\Managed</ManagedDir>
    <!-- Together (CasualtiesMP) is only needed to COMPILE the optional multiplayer bridge.
         At runtime the mod works without it. -->
    <TogetherDir Condition="'$(TogetherDir)' == ''">..\Casualties-Together\MPMod_5.5.0_fullgame1.0_bepinex5.4.23.5\mod\BepInEx\plugins\Together</TogetherDir>
    <!-- Set -p:Deploy=false to build without copying into the game. -->
    <Deploy Condition="'$(Deploy)' == ''">true</Deploy>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CasualtiesMP"><HintPath>$(TogetherDir)\CasualtiesMP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LiteNetLib"><HintPath>$(TogetherDir)\LiteNetLib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' == 'true'">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\plugins\MultiplayerSpriteReplacer" />
  </Target>

</Project>
